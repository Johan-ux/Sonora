# Formato común para cualquier editor (IntelliJ y VS Code lo leen solos).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml}]
indent_size = 2

# cmd.exe falla con etiquetas y goto si un .bat lleva LF (ver .gitattributes).
[*.bat]
end_of_line = crlf

# En Markdown, dos espacios al final de una línea son un salto de línea.
[*.md]
trim_trailing_whitespace = false
